/**
  @file test_lineage.sas
  @brief Regression tests for the lineage macros. Run through tests/run_tests.py.
  @details Every scenario records real SCAPROC output of a small program, then checks the lineage
  tables the macros derive from it. SCAPROC does not record the source of code that is %included or
  generated by a macro, so tests/run_tests.py submits this file in chunks (split at the SUBMIT marker
  lines): the code of each scenario is then submitted directly, as in an interactive session. Expects the macro variables
    g_codeRoot  folder holding the lin_*.sas macros
    g_testRoot  scratch folder for the recordings / outputs
**/

%macro t_includeAll;
  %LOCAL i f;
  %let f = lin_startRecord lin_stopRecord lin_readLog lin_prepSource lin_exprDataStep lin_exprSql lin_tokenize lin_buildLineage
           lin_writeDag lin_writeJson lin_processLog lin_runAll;
  %do i = 1 %to %sysfunc(countw(&f));
    %include "&g_codeRoot/%scan(&f, &i).sas";
  %end;
%mend t_includeAll;
%t_includeAll
%include "&g_testRoot/test_framework.sas";

/* run the extraction chain (no DOT output) for one recording */
%macro t_lineage(p_file=, p_prefix=);
  %lin_readLog(p_inFile=&p_file, p_prefix=&p_prefix)
  %lin_prepSource(p_prefix=&p_prefix)
  %lin_exprDataStep(p_prefix=&p_prefix)
  %lin_exprSql(p_prefix=&p_prefix)
  %lin_tokenize(p_prefix=&p_prefix)
  %lin_buildLineage(p_prefix=&p_prefix)
%mend t_lineage;

OPTIONS DLCREATEDIR NONOTES;
LIBNAME _tmk "&g_testRoot/rec";
LIBNAME _tmk CLEAR;
LIBNAME _tmk "&g_testRoot/out";
LIBNAME _tmk CLEAR;
OPTIONS NOTES;

/*@@SUBMIT*/
/* =========================================================================
   Scenario A: DATA step derivations
   ========================================================================= */
%t_recordStart(p_file=&g_testRoot/rec/a.txt)

DATA work.src;
  INPUT a b c $;
  DATALINES;
1 2 x
3 4 y
;
RUN;

DATA work.d1 (RENAME=(c=cc));
  SET work.src;
  x = a + b;
  y = x * 2;
  IF (a > 1) THEN z = b; ELSE z = 0;
  k = 5;
RUN;

%t_recordStop
%t_lineage(p_file=&g_testRoot/rec/a.txt, p_prefix=ta)

%t_rows(p_name=A1 expression x comes from a, p_ds=ta_collin, p_where=%str(method='EXPR' and toDs='WORK.D1' and toVar='x' and fromVar='a'))
%t_rows(p_name=A2 expression x comes from b, p_ds=ta_collin, p_where=%str(method='EXPR' and toDs='WORK.D1' and toVar='x' and fromVar='b'))
%t_rows(p_name=A3 y comes from a through x, p_ds=ta_collin, p_where=%str(toDs='WORK.D1' and toVar='y' and fromVar='a'))
%t_rows(p_name=A4 y comes from b through x, p_ds=ta_collin, p_where=%str(toDs='WORK.D1' and toVar='y' and fromVar='b'))
%t_rows(p_name=A5 y has no edge from itself or x, p_ds=ta_collin, p_where=%str(toDs='WORK.D1' and toVar='y' and fromVar in ('y', 'x')), p_expect=0)
%t_rows(p_name=A6 IF/THEN branch z comes from b, p_ds=ta_collin, p_where=%str(toDs='WORK.D1' and toVar='z' and fromVar='b'))
%t_rows(p_name=A7 constant branch of z is CONST, p_ds=ta_collin, p_where=%str(toDs='WORK.D1' and toVar='z' and method='CONST'))
%t_rows(p_name=A8 k = 5 is CONST, p_ds=ta_collin, p_where=%str(toDs='WORK.D1' and toVar='k' and method='CONST'))
%t_rows(p_name=A9 rename c to cc is RENAME, p_ds=ta_collin, p_where=%str(toDs='WORK.D1' and toVar='cc' and fromVar='c' and method='RENAME'))
%t_rows(p_name=A10 a passes through by name, p_ds=ta_collin, p_where=%str(toDs='WORK.D1' and toVar='a' and fromVar='a' and method='NAME'))
%t_rows(p_name=A11 in-stream data columns are INPUT, p_ds=ta_collin, p_where=%str(toDs='WORK.SRC' and method='INPUT' and fromKind='INLINE'), p_expect=3)
%t_rows(p_name=A12 nothing is unresolved, p_ds=ta_collin, p_where=%str(method='UNRESOLVED'), p_expect=0)

/*@@SUBMIT*/
/* =========================================================================
   Scenario B: PROC SQL derivations
   ========================================================================= */
%t_recordStart(p_file=&g_testRoot/rec/b.txt)

DATA work.s1;
  INPUT a b c $;
  DATALINES;
1 2 x
3 4 y
;
RUN;
DATA work.s2;
  INPUT a v w;
  DATALINES;
1 10 100
3 30 300
;
RUN;

PROC SQL;
  CREATE TABLE work.j AS
  SELECT t1.a AS id
       , t1.b + t2.v AS total
       , calculated total * 2 AS dbl
       , CASE WHEN t1.c = 'x' THEN 1 ELSE 0 END AS flag
       , 'k' AS konst
  FROM work.s1 t1 INNER JOIN work.s2 AS t2 ON t1.a = t2.a;

  CREATE TABLE work.u AS
  SELECT a AS p, b AS q FROM work.s1
  UNION ALL
  SELECT v, w FROM work.s2;

  CREATE TABLE work.cp AS SELECT * FROM work.s1;
QUIT;

%t_recordStop
%t_lineage(p_file=&g_testRoot/rec/b.txt, p_prefix=tb)

%t_rows(p_name=B1 id comes from s1.a only, p_ds=tb_collin, p_where=%str(toDs='WORK.J' and toVar='id' and method='EXPR' and fromDs='WORK.S1' and fromVar='a'))
%t_rows(p_name=B2 id has one source, p_ds=tb_collin, p_where=%str(toDs='WORK.J' and toVar='id'))
%t_rows(p_name=B3 total comes from s1.b, p_ds=tb_collin, p_where=%str(toDs='WORK.J' and toVar='total' and fromDs='WORK.S1' and fromVar='b'))
%t_rows(p_name=B4 total comes from s2.v, p_ds=tb_collin, p_where=%str(toDs='WORK.J' and toVar='total' and fromDs='WORK.S2' and fromVar='v'))
%t_rows(p_name=B5 CALCULATED total resolves to s1.b and s2.v, p_ds=tb_collin, p_where=%str(toDs='WORK.J' and toVar='dbl'), p_expect=2)
%t_rows(p_name=B6 CASE flag comes from s1.c, p_ds=tb_collin, p_where=%str(toDs='WORK.J' and toVar='flag' and fromDs='WORK.S1' and fromVar='c'))
%t_rows(p_name=B7 literal column is CONST, p_ds=tb_collin, p_where=%str(toDs='WORK.J' and toVar='konst' and method='CONST'))
%t_rows(p_name=B8 join key s2.a feeds no output, p_ds=tb_collin, p_where=%str(toDs='WORK.J' and fromDs='WORK.S2' and fromVar='a'), p_expect=0)
%t_rows(p_name=B9 UNION p from s1.a, p_ds=tb_collin, p_where=%str(toDs='WORK.U' and toVar='p' and fromDs='WORK.S1' and fromVar='a'))
%t_rows(p_name=B10 UNION p from s2.v by position, p_ds=tb_collin, p_where=%str(toDs='WORK.U' and toVar='p' and fromDs='WORK.S2' and fromVar='v'))
%t_rows(p_name=B11 UNION q from s2.w by position, p_ds=tb_collin, p_where=%str(toDs='WORK.U' and toVar='q' and fromDs='WORK.S2' and fromVar='w'))
%t_rows(p_name=B12 SELECT star copies by name, p_ds=tb_collin, p_where=%str(toDs='WORK.CP' and method='NAME' and fromDs='WORK.S1'), p_expect=3)
%t_rows(p_name=B13 nothing is unresolved, p_ds=tb_collin, p_where=%str(method='UNRESOLVED'), p_expect=0)

/*@@SUBMIT*/
/* =========================================================================
   Scenario C: a data set rewritten in place gets a new version (no cycle)
   ========================================================================= */
%t_recordStart(p_file=&g_testRoot/rec/c.txt)

DATA work.q;
  INPUT a b;
  DATALINES;
2 1
1 2
;
RUN;
PROC SORT DATA=work.q;
  BY a;
RUN;
DATA work.r;
  SET work.q;
  s = a + b;
RUN;

%t_recordStop
%t_lineage(p_file=&g_testRoot/rec/c.txt, p_prefix=tc)

%t_rows(p_name=C1 q is written twice, p_ds=tc_dsver, p_where=%str(ds='WORK.Q' and io='OUT'), p_expect=2)
%t_rows(p_name=C2 sort reads q version 1, p_ds=tc_dsver, p_where=%str(ds='WORK.Q' and io='IN' and ver=1))
%t_rows(p_name=C3 sort writes q version 2, p_ds=tc_dsver, p_where=%str(ds='WORK.Q' and io='OUT' and ver=2))
%t_rows(p_name=C4 sort column edge goes v1 to v2, p_ds=tc_collin, p_where=%str(procname='SORT' and toDs='WORK.Q' and toVer=2 and fromVer=1 and fromVar='a'))
%t_rows(p_name=C5 later step reads version 2, p_ds=tc_collin, p_where=%str(toDs='WORK.R' and toVar='s' and fromDs='WORK.Q' and fromVer=2), p_expect=2)
%t_rows(p_name=C6 no edge reads and writes the same version, p_ds=tc_collin, p_where=%str(fromKind='DS' and fromDs=toDs and fromVer=toVer), p_expect=0)

/*@@SUBMIT*/
/* =========================================================================
   Scenario D: files
   ========================================================================= */
%t_recordStart(p_file=&g_testRoot/rec/d.txt)

FILENAME tcsv "&g_testRoot/rec/d_in.csv";
DATA _NULL_;
  FILE tcsv;
  PUT '1,2';
  PUT '3,4';
RUN;
DATA work.f;
  INFILE tcsv DLM=',';
  INPUT p q;
RUN;
PROC IMPORT DATAFILE="&g_testRoot/rec/d_in.csv" OUT=work.imp DBMS=CSV REPLACE;
  GETNAMES=NO;
RUN;
DATA work.imp2;
  SET work.imp;
RUN;
FILENAME tcsv CLEAR;

%t_recordStop
%t_lineage(p_file=&g_testRoot/rec/d.txt, p_prefix=td)

%t_rows(p_name=D1 INPUT statement reads from the infile, p_ds=td_collin, p_where=%str(toDs='WORK.F' and method='INPUT' and fromKind='FILE' and index(fromDs,'d_in.csv')>0), p_expect=2)
%t_rows(p_name=D2 PROC IMPORT columns come from the file, p_ds=td_collin, p_where=%str(toDs='WORK.IMP' and fromKind='FILE' and index(fromDs,'d_in.csv')>0), p_expect=2)
%t_rows(p_name=D3 the file written by the first step is recorded, p_ds=td_fileio, p_where=%str(role='OUTPUT' and index(path,'d_in.csv')>0), p_expect=1)

/*@@SUBMIT*/
/* =========================================================================
   Scenario E: DOT output, CSV output and the whole-folder run
   ========================================================================= */
%lin_processLog(p_inFile=&g_testRoot/rec/b.txt, p_outDir=&g_testRoot/out, p_name=eb, p_attrs_yn=Y)
%t_assert(p_name=E1 processLog returns 0, p_cond=&g_linRC = 0)
%t_assert(p_name=E2 dataset dot exists, p_cond=%sysfunc(fileexist(&g_testRoot/out/eb_dataset.dot)) = 1)
%t_assert(p_name=E3 column dot exists, p_cond=%sysfunc(fileexist(&g_testRoot/out/eb_column.dot)) = 1)
%t_assert(p_name=E4 column lineage csv exists, p_cond=%sysfunc(fileexist(&g_testRoot/out/eb_column_lineage.csv)) = 1)
%t_assert(p_name=E5 dataset lineage csv exists, p_cond=%sysfunc(fileexist(&g_testRoot/out/eb_dataset_lineage.csv)) = 1)
%t_assert(p_name=E6 steps csv exists, p_cond=%sysfunc(fileexist(&g_testRoot/out/eb_steps.csv)) = 1)

%t_dotDangling(p_file=&g_testRoot/out/eb_dataset.dot, p_outVar=t_dang1)
%t_assert(p_name=E7 dataset dot: every edge endpoint has a node, p_cond=&t_dang1 = 0)
%t_dotDangling(p_file=&g_testRoot/out/eb_column.dot, p_outVar=t_dang2)
%t_assert(p_name=E8 column dot: every edge endpoint has a node, p_cond=&t_dang2 = 0)

%t_countRegex(p_file=&g_testRoot/out/eb_column.dot, p_regex=%str(^\s*subgraph .cluster_), p_outVar=t_clusters)
%t_assert(p_name=E9 column dot has one cluster per data set, p_cond=&t_clusters = 5)
%t_countRegex(p_file=&g_testRoot/out/eb_dataset.dot, p_regex=%str(shape=.oval.), p_outVar=t_steps)
%t_count(p_ds=tb_steps)
%t_assert(p_name=E10 dataset dot has a node per step, p_cond=&t_steps = &t_n)
%t_countRegex(p_file=&g_testRoot/out/eb_dataset.dot, p_regex=%str(<TABLE ), p_outVar=t_tabs)
%t_assert(p_name=E11 attrs=Y lists the columns in the data set nodes, p_cond=&t_tabs = 5)
%t_countRegex(p_file=&g_testRoot/out/eb_column.dot, p_regex=%str(\->), p_outVar=t_cedges)

%t_count(p_ds=tb_collin, p_where=%str(fromKind ne 'NONE'))
%t_assert(p_name=E12 one column edge per lineage row, p_cond=&t_cedges = &t_n)

/* DAG without steps, no column DAG */
%lin_processLog(p_inFile=&g_testRoot/rec/b.txt, p_outDir=&g_testRoot/out, p_name=ebn, p_includeSteps_yn=N, p_columnDag_yn=N)
%t_countRegex(p_file=&g_testRoot/out/ebn_dataset.dot, p_regex=%str(shape=.oval.), p_outVar=t_steps2)
%t_assert(p_name=E13 includeSteps=N draws no step nodes, p_cond=&t_steps2 = 0)
%t_dotDangling(p_file=&g_testRoot/out/ebn_dataset.dot, p_outVar=t_dang3)
%t_assert(p_name=E14 includeSteps=N: every edge endpoint has a node, p_cond=&t_dang3 = 0)
%t_assert(p_name=E15 columnDag=N writes no column dot, p_cond=%sysfunc(fileexist(&g_testRoot/out/ebn_column.dot)) = 0)

/* whole folder: 4 recordings + 1 empty file */
OPTIONS DLCREATEDIR NONOTES;
LIBNAME _tmk "&g_testRoot/all";
LIBNAME _tmk CLEAR;
LIBNAME _tmk "&g_testRoot/allout";
LIBNAME _tmk CLEAR;
OPTIONS NOTES;
DATA _NULL_;
  LENGTH fref $8;
  DO f = 'a', 'b', 'c', 'd';
    rc = FILENAME(fref, CATS("&g_testRoot/all/", f, ".txt"));
    rc = FDELETE(fref);
    rc = FILENAME(fref);
  END;
RUN;
%macro t_copy(p_name=);
  DATA _NULL_;
    INFILE "&g_testRoot/rec/&p_name..txt" LRECL=32767;
    FILE "&g_testRoot/all/&p_name..txt" LRECL=32767;
    INPUT;
    PUT _INFILE_;
  RUN;
%mend t_copy;
%t_copy(p_name=a) %t_copy(p_name=b) %t_copy(p_name=c) %t_copy(p_name=d)
DATA _NULL_;
  FILE "&g_testRoot/all/empty.txt";
RUN;
DATA _NULL_;
  FILE "&g_testRoot/all/notes.log";
  PUT 'not a recording';
RUN;

%lin_runAll(p_logDir=&g_testRoot/all, p_outDir=&g_testRoot/allout)
%t_rows(p_name=F1 summary has one row per .txt file, p_ds=work.lin_summary, p_expect=5)
%t_rows(p_name=F2 four recordings are OK, p_ds=work.lin_summary, p_where=%str(status='OK'), p_expect=4)
%t_rows(p_name=F3 the empty file is reported EMPTY, p_ds=work.lin_summary, p_where=%str(status='EMPTY' and name='empty'))
%t_assert(p_name=F4 summary csv written, p_cond=%sysfunc(fileexist(&g_testRoot/allout/lineage_summary.csv)) = 1)
%t_assert(p_name=F5 every recording has its own folder, p_cond=%sysfunc(fileexist(&g_testRoot/allout/b/b_column.dot)) = 1)
%t_assert(p_name=F6 non .txt files are ignored, p_cond=%sysfunc(fileexist(&g_testRoot/allout/notes)) = 0)

/*@@SUBMIT*/
/* =========================================================================
   Scenario G: lin_startRecord / lin_stopRecord
   ========================================================================= */
DATA _NULL_;
  FILE "&g_testRoot/rec/g.txt";
  PUT 'STALE CONTENT FROM AN EARLIER RUN';
RUN;
%lin_startRecord(p_outFile=&g_testRoot/rec/g.txt)
DATA work.g0;
  x = 1;
RUN;
DATA work.g1;
  SET work.g0;
  y = x + 1;
RUN;
%lin_stopRecord
%t_lineage(p_file=&g_testRoot/rec/g.txt, p_prefix=tg)
%t_rows(p_name=G1 stale recording content is replaced, p_ds=tg_collin, p_where=%str(toDs='WORK.G1' and toVar='y' and fromVar='x' and method='EXPR'))
%lin_startRecord(p_outFile=&g_testRoot/rec/g_off.txt, p_enableFlagName=g_noSuchFlag)
%lin_stopRecord(p_enableFlagName=g_noSuchFlag)
%t_assert(p_name=G2 flag off: nothing is recorded, p_cond=%sysfunc(fileexist(&g_testRoot/rec/g_off.txt)) = 0)

/*@@SUBMIT*/
/* =========================================================================
   Scenario H: JSON graph (both levels)
   ========================================================================= */
%lin_processLog(p_inFile=&g_testRoot/rec/a.txt, p_outDir=&g_testRoot/out, p_name=ja, p_attrs_yn=Y, p_json_yn=Y)
%lin_processLog(p_inFile=&g_testRoot/rec/d.txt, p_outDir=&g_testRoot/out, p_name=jd, p_json_yn=Y)
%lin_processLog(p_inFile=&g_testRoot/rec/a.txt, p_outDir=&g_testRoot/out, p_name=jn, p_includeSteps_yn=N, p_columnDag_yn=N, p_json_yn=Y)
%lin_processLog(p_inFile=&g_testRoot/rec/b.txt, p_outDir=&g_testRoot/out, p_name=jx)
%t_assert(p_name=H1 json file written, p_cond=%sysfunc(fileexist(&g_testRoot/out/ja.json)) = 1)
%t_assert(p_name=H2 no json unless asked, p_cond=%sysfunc(fileexist(&g_testRoot/out/jx.json)) = 0)

LIBNAME tj JSON "&g_testRoot/out/ja.json";   /* the JSON engine fails on invalid JSON */
PROC SQL NOPRINT;
  SELECT COUNT(*) INTO :j_nodes  TRIMMED FROM tj.nodes;
  SELECT COUNT(*) INTO :j_ds     TRIMMED FROM tj.nodes WHERE type = 'dataset' AND level = 'dataset';
  SELECT COUNT(*) INTO :j_steps  TRIMMED FROM tj.nodes WHERE type = 'step';
  SELECT COUNT(*) INTO :j_colnd  TRIMMED FROM tj.nodes WHERE type = 'column' AND level = 'column';
  SELECT COUNT(*) INTO :j_dsedge TRIMMED FROM tj.edges WHERE level = 'dataset' AND type IN ('input', 'output');
  SELECT COUNT(*) INTO :j_coled  TRIMMED FROM tj.edges WHERE level = 'column' AND type = 'column';
  SELECT COUNT(*) INTO :j_expr   TRIMMED FROM tj.edges WHERE method = 'EXPR' AND expr IS NOT NULL;
  SELECT COUNT(*) INTO :j_dangle TRIMMED FROM tj.edges
    WHERE source NOT IN (SELECT id FROM tj.nodes) OR target NOT IN (SELECT id FROM tj.nodes);
  SELECT COUNT(*) INTO :j_nocol  TRIMMED FROM tj.nodes WHERE type = 'column' AND dataset NOT IN (SELECT id FROM tj.nodes);
  SELECT COUNT(*) INTO :j_attrs  TRIMMED FROM tj.nodes_columns;
QUIT;
LIBNAME tj CLEAR;
%t_assert(p_name=H3 json has nodes, p_cond=&j_nodes > 0)
%t_assert(p_name=H4 json has data set nodes, p_cond=&j_ds ge 2)
%t_assert(p_name=H5 json has step nodes, p_cond=&j_steps ge 2)
%t_assert(p_name=H6 json has column nodes, p_cond=&j_colnd ge 5)
%t_assert(p_name=H7 json has data set edges, p_cond=&j_dsedge ge 4)
%t_assert(p_name=H8 json has column edges, p_cond=&j_coled ge 5)
%t_assert(p_name=H9 expression edges carry the expression, p_cond=&j_expr ge 1)
%t_assert(p_name=H10 every edge endpoint is a node, p_cond=&j_dangle = 0)
%t_assert(p_name=H11 every column node belongs to a data set node, p_cond=&j_nocol = 0)
%t_assert(p_name=H12 attrs=Y lists the columns in the data set nodes, p_cond=&j_attrs ge 5)

LIBNAME tj JSON "&g_testRoot/out/jd.json";
PROC SQL NOPRINT;
  SELECT COUNT(*) INTO :j_file   TRIMMED FROM tj.nodes WHERE type = 'file';
  SELECT COUNT(*) INTO :j_dang2  TRIMMED FROM tj.edges
    WHERE source NOT IN (SELECT id FROM tj.nodes) OR target NOT IN (SELECT id FROM tj.nodes);
QUIT;
LIBNAME tj CLEAR;
%t_assert(p_name=H13 file recording has file nodes, p_cond=&j_file ge 1)
%t_assert(p_name=H14 file recording: every edge endpoint is a node, p_cond=&j_dang2 = 0)

LIBNAME tj JSON "&g_testRoot/out/jn.json";
PROC SQL NOPRINT;
  SELECT COUNT(*) INTO :j_flow   TRIMMED FROM tj.edges WHERE type = 'flow';
  SELECT COUNT(*) INTO :j_stp2   TRIMMED FROM tj.nodes WHERE type = 'step';
  SELECT COUNT(*) INTO :j_col2   TRIMMED FROM tj.nodes WHERE type = 'column';
  SELECT COUNT(*) INTO :j_dang3  TRIMMED FROM tj.edges
    WHERE source NOT IN (SELECT id FROM tj.nodes) OR target NOT IN (SELECT id FROM tj.nodes);
QUIT;
LIBNAME tj CLEAR;
%t_assert(p_name=H15 steps=N links inputs to outputs with flow edges, p_cond=&j_flow ge 1)
%t_assert(p_name=H16 steps=N has no step nodes, p_cond=&j_stp2 = 0)
%t_assert(p_name=H17 columnDag=N has no column nodes, p_cond=&j_col2 = 0)
%t_assert(p_name=H18 steps=N: every edge endpoint is a node, p_cond=&j_dang3 = 0)

/*@@SUBMIT*/
/* =========================================================================
   Scenario I: SASHELP (a concatenated library SAS opens under a #C... alias) is a real input
   ========================================================================= */
%t_recordStart(p_file=&g_testRoot/rec/i.txt)

PROC SUMMARY DATA=sashelp.class NWAY;
  CLASS sex;
  VAR age height;
  OUTPUT OUT=work.i1 (DROP=_:) SUM=;
RUN;

%t_recordStop
%t_lineage(p_file=&g_testRoot/rec/i.txt, p_prefix=ti)

%t_rows(p_name=I1 sashelp.class is an input of the step, p_ds=ti_dsio, p_where=%str(ds='SASHELP.CLASS' and role='INPUT'))
%t_rows(p_name=I2 no alias library is left, p_ds=ti_dsio, p_where=%str(substr(ds, 1, 1)='#'), p_expect=0)
%t_rows(p_name=I3 output columns come from sashelp.class, p_ds=ti_collin, p_where=%str(toDs='WORK.I1' and fromDs='SASHELP.CLASS' and method='NAME'), p_expect=3)
%t_rows(p_name=I4 nothing is unresolved, p_ds=ti_collin, p_where=%str(method='UNRESOLVED'), p_expect=0)

%put TEST_DONE;

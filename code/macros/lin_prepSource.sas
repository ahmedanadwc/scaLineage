/**
  @file lin_prepsource.sas
  @brief Splits the recorded source of every step into statements.
  @details Reads &p_prefix._src (see %lin_readLog) and creates

  <ul><li>work.&p_prefix._stmts: Source code for each step split into individual statements</li>
  |Variable|Description|
  |---|---|
  |step|The step number of the statement|
  |stmtno|The statement number within the step|
  |text|The text of the statement (no trailing semicolon)|
  </ul>

  Example usage:

      %lin_prepSource(p_prefix=&p_prefix, p_srcDsName=work.&p_prefix._src)

  Cleaning applied before splitting: block comments are removed, in-stream data
  (DATALINES/CARDS ... ;) is dropped, white space is collapsed, and semicolons inside
  quoted strings do not end a statement.

  Steps generated by a macro have no recorded source; they simply get no rows here, and the
  lineage engines fall back to matching columns by name.

  @param [in] p_prefix= Prefix of the WORK tables. Default:lin.
  @param [in] p_srcDsName= Source code for each step. Default: work.&p_prefix._src

  <h4> Data Inputs </h4>
  @li work.&p_prefix._src


  <h4> Data Outputs </h4>
  @li work.&p_prefix._stmts


  @version 9.4
  @author Ahmed Al-Attar
**/

%macro lin_prepSource(p_prefix=lin, p_srcDsName=work.&p_prefix._src);

  /* 1. glue the source lines of each step into one string, dropping in-stream data lines */
  DATA work._lin_oneline (KEEP=step src);
    SET &p_srcDsName;
    BY step;
    LENGTH src $32000;
    RETAIN src '' inData 0;
    IF (FIRST.step) THEN
    DO;
      src = '';
      inData = 0;
    END;

    IF (inData) THEN
    DO;
      /* in-stream data ends at a line that starts with a semicolon */
      IF (STRIP(text) =: ';') THEN inData = 0;
    END;
    ELSE
    DO;
      src = CATX(' ', src, STRIP(TRANSLATE(text, '  ', '090D'x)));
      IF (PRXMATCH('/\b(datalines|datalines4|cards|cards4)\s*;\s*$/i', text)) THEN inData = 1;
    END;
    IF (LAST.step) THEN OUTPUT;
  RUN;

  /* 2. strip block comments, then split into statements outside of quotes */
  DATA &p_prefix._stmts (KEEP=step stmtno text);
    SET work._lin_oneline;
    LENGTH text $32000 q $1 ch $1;
    RETAIN rxCmt;
    IF (_n_ = 1) THEN rxCmt = PRXPARSE('s/\/\*.*?\*\// /');
    CALL PRXCHANGE(rxCmt, -1, src);
    src = COMPBL(src);

    stmtno = 0;
    q = '';
    text = '';
    k = 0;                       /* characters currently in text */
    n = LENGTH(src);
    DO i = 1 TO n;
      ch = SUBSTR(src, i, 1);
      IF (ch = ';' AND q = '') THEN
      DO;
        IF (k > 0 AND NOT MISSING(text)) THEN
        DO;
          stmtno + 1;
          text = STRIP(text);
          OUTPUT;
        END;
        text = '';
        k = 0;
      END;
      ELSE
      DO;
        IF (q NE '') THEN
        DO;
          IF (ch = q) THEN q = '';
        END;
        ELSE IF (ch IN ("'", '"')) THEN q = ch;
        k + 1;
        SUBSTR(text, k, 1) = ch;
      END;
    END;
    IF (k > 0 AND NOT MISSING(text)) THEN
    DO;
      stmtno + 1;
      text = STRIP(text);
      OUTPUT;
    END;
  RUN;

  PROC DATASETS LIB=WORK NOLIST NOWARN;
    DELETE _lin_oneline;
  RUN; QUIT;

%mend lin_prepSource;

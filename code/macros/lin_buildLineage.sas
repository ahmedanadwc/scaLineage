/**
  @file lin_buildLineage.sas
  @brief Resolves the column level lineage of one SCAPROC recording.
  @details Needs the tables of %lin_readLog, %lin_prepSource, %lin_exprDataStep, %lin_exprSql and
  %lin_tokenize. SCAPROC records which columns every step read and wrote (ATTR records). Those
  facts are combined with the derivations found in the step source, so every column written by a step
  gets one or more edges back to the column(s) it came from:

    EXPR       derived by an expression (assignment / select item); EXPR holds the text
    RENAME     renamed (rename= option or RENAME statement)
    NAME       same column name in an input of the step (pass-through; also the only
               information available for steps generated by a macro, which have no recorded source)
    FILE       read from an external file (PROC IMPORT, INFILE, ...)
    INPUT      read by an INPUT statement from an INFILE or in-stream data
    CONST      expression without any column (constant, COUNT(*), ...)
    UNRESOLVED nothing in the recording says where the column came from

  A data set that is written more than once gets a version number (1, 2, ...), so a step that reads
  and rewrites the same table (PROC SORT, PROC APPEND, ...) does not create a cycle. Version 0 is a
  data set that was only read (it already existed).

  Creates

    &p_prefix._collin  step, procname, method, fromKind(DS|FILE|INLINE|NONE), fromDs, fromVer, fromVar,
                       toDs, toVer, toVar, expr
    &p_prefix._dsver   step, io(IN|OUT), ds, ver

  @param [in] p_prefix= Prefix of the WORK tables. Default:lin.

  @version 9.4
  @author Ahmed Al-Attar
**/
%macro lin_buildLineage(p_prefix=lin);

  %LOCAL l_i l_added;

  /* PROC IMPORT (and similar) read the file with a generated DATA step that SCAPROC also records as
     reading the table it is creating. Such a "ghost" input is dropped: the table comes from the file. */
  PROC SQL;
    CREATE TABLE work._lin_ghost AS
    SELECT DISTINCT i.step, i.ds
    FROM &p_prefix._dsio i
    INNER JOIN &p_prefix._dsio o ON o.step = i.step AND o.ds = i.ds AND o.role = 'OUTPUT'
    WHERE i.role = 'INPUT'
      AND i.step IN (SELECT step FROM &p_prefix._fileio WHERE role = 'INPUT')
      AND NOT EXISTS (SELECT 1 FROM &p_prefix._dsio w WHERE w.ds = i.ds AND w.role IN ('OUTPUT', 'UPDATE') AND w.step < i.step);

    DELETE FROM &p_prefix._dsio a
    WHERE a.role = 'INPUT' AND EXISTS (SELECT 1 FROM work._lin_ghost g WHERE g.step = a.step AND g.ds = a.ds);
    DELETE FROM &p_prefix._attrs a
    WHERE a.role = 'INPUT' AND EXISTS (SELECT 1 FROM work._lin_ghost g WHERE g.step = a.step AND g.ds = a.ds);
  QUIT;

  /* ---- attributes: drop repeated records, number the output columns of every data set ---- */
  PROC SORT DATA=&p_prefix._attrs OUT=work._lin_a NODUPKEY;
    BY step role ds var;
  RUN;
  PROC SORT DATA=work._lin_a;
    BY step role ds ord;
  RUN;
  DATA work._lin_a;
    SET work._lin_a;
    BY step role ds;
    LENGTH ukey $64;
    RETAIN seq 0;
    IF (FIRST.ds) THEN seq = 0;
    seq + 1;
    ukey = UPCASE(var);
  RUN;

  /* ---- data set names written by the SQL source -> the LIB.MEM names SCAPROC recorded ---- */
  PROC SQL NOPRINT;
    CREATE TABLE work._lin_dsmem AS
    SELECT DISTINCT step, ds, SCAN(ds, 2, '.') AS mem LENGTH=64
    FROM &p_prefix._dsio;

    CREATE TABLE work._lin_raw AS
    SELECT DISTINCT step, tblRaw AS raw LENGTH=200 FROM &p_prefix._alias WHERE tblRaw NE '(subquery)'
    UNION
    SELECT DISTINCT step, toRaw FROM &p_prefix._eexpr WHERE NOT MISSING(toRaw);

    CREATE TABLE work._lin_nm AS
    SELECT DISTINCT r.step, r.raw
         , COALESCE(d.ds, CASE WHEN INDEX(r.clean, '.') > 0 THEN r.clean ELSE CATS('WORK.', r.clean) END) AS ds LENGTH=80
    FROM (SELECT step, raw, UPCASE(STRIP(SCAN(raw, 1, '('))) AS clean LENGTH=200 FROM work._lin_raw) r
    LEFT JOIN work._lin_dsmem d
      ON d.step = r.step AND (d.ds = r.clean OR (INDEX(r.clean, '.') = 0 AND d.mem = r.clean));

    CREATE TABLE work._lin_al AS
    SELECT a.step, a.qid, a.alias, n.ds LENGTH=80
    FROM &p_prefix._alias a
    LEFT JOIN work._lin_nm n ON n.step = a.step AND n.raw = a.tblRaw;

    /* ---- which output columns does each expression define? ---- */
    CREATE TABLE work._lin_tgt AS
    SELECT e.eid, o.ds AS toDs LENGTH=80, o.var AS toVar LENGTH=64
    FROM &p_prefix._eexpr e
    INNER JOIN work._lin_a o ON o.step = e.step AND o.role = 'OUTPUT' AND o.ukey = UPCASE(e.toVar)
    WHERE e.qid = 0
    UNION
    SELECT e.eid, o.ds, o.var
    FROM &p_prefix._eexpr e
    INNER JOIN work._lin_nm n ON n.step = e.step AND n.raw = e.toRaw
    INNER JOIN work._lin_a o ON o.step = e.step AND o.role = 'OUTPUT' AND o.ds = n.ds
       AND ((NOT MISSING(e.toVar) AND o.ukey = UPCASE(e.toVar)) OR (MISSING(e.toVar) AND o.seq = e.pos))
    WHERE e.qid > 0;

    /* ---- which input columns does each reference point to? ---- */
    CREATE TABLE work._lin_src0 AS
    /* DATA step: any input column with that name */
    SELECT r.eid, r.ident LENGTH=64, i.ds AS fromDs LENGTH=80, i.var AS fromVar LENGTH=64
    FROM &p_prefix._ref r
    INNER JOIN &p_prefix._eexpr e ON e.eid = r.eid
    INNER JOIN work._lin_a i ON i.step = e.step AND i.role = 'INPUT' AND i.ukey = UPCASE(r.ident)
    WHERE e.qid = 0
    UNION
    /* SQL: alias.column with a known table */
    SELECT r.eid, r.ident, i.ds, i.var
    FROM &p_prefix._ref r
    INNER JOIN &p_prefix._eexpr e ON e.eid = r.eid
    INNER JOIN work._lin_al a ON a.step = e.step AND a.qid = e.qid AND a.alias = UPCASE(r.qual) AND NOT MISSING(a.ds)
    INNER JOIN work._lin_a i ON i.step = e.step AND i.role = 'INPUT' AND i.ds = a.ds AND i.ukey = UPCASE(r.ident)
    WHERE e.qid > 0 AND NOT MISSING(r.qual) AND r.calc = 0
    UNION
    /* SQL: alias.column where the alias is a sub-query / unknown: any input column with that name */
    SELECT r.eid, r.ident, i.ds, i.var
    FROM &p_prefix._ref r
    INNER JOIN &p_prefix._eexpr e ON e.eid = r.eid
    INNER JOIN work._lin_a i ON i.step = e.step AND i.role = 'INPUT' AND i.ukey = UPCASE(r.ident)
    WHERE e.qid > 0 AND NOT MISSING(r.qual) AND r.calc = 0
      AND NOT EXISTS (SELECT 1 FROM work._lin_al a
                      WHERE a.step = e.step AND a.qid = e.qid AND a.alias = UPCASE(r.qual) AND NOT MISSING(a.ds))
    UNION
    /* SQL: plain column, looked for in the tables of its query segment (or in every input if none are known) */
    SELECT r.eid, r.ident, i.ds, i.var
    FROM &p_prefix._ref r
    INNER JOIN &p_prefix._eexpr e ON e.eid = r.eid
    INNER JOIN work._lin_a i ON i.step = e.step AND i.role = 'INPUT' AND i.ukey = UPCASE(r.ident)
    WHERE e.qid > 0 AND MISSING(r.qual) AND r.calc = 0
      AND (NOT EXISTS (SELECT 1 FROM work._lin_al a WHERE a.step = e.step AND a.qid = e.qid AND NOT MISSING(a.ds))
           OR i.ds IN (SELECT a.ds FROM work._lin_al a WHERE a.step = e.step AND a.qid = e.qid));

    /* ---- references to a column that was itself derived in the same step / query segment ---- */
    CREATE TABLE work._lin_dr AS
    SELECT DISTINCT r.eid, f.eid AS depEid
    FROM &p_prefix._ref r
    INNER JOIN &p_prefix._eexpr e ON e.eid = r.eid
    INNER JOIN &p_prefix._eexpr f ON f.step = e.step AND f.qid = e.qid AND f.kind = 'EXPR'
       AND UPCASE(f.toVar) = UPCASE(r.ident) AND f.eid NE r.eid
    WHERE e.kind = 'EXPR'
      AND NOT EXISTS (SELECT 1 FROM work._lin_src0 s WHERE s.eid = r.eid AND s.ident = r.ident);

    CREATE TABLE work._lin_res AS
    SELECT DISTINCT eid, fromDs, fromVar FROM work._lin_src0;
  QUIT;

  /* transitive closure: x = a; y = x * 2;  ->  y comes from a */
  %let l_added = 1;
  %do l_i = 1 %to 8;
    %if (&l_added > 0) %then
    %do;
      PROC SQL NOPRINT;
        CREATE TABLE work._lin_new AS
        SELECT DISTINCT d.eid, s.fromDs, s.fromVar
        FROM work._lin_dr d
        INNER JOIN work._lin_res s ON s.eid = d.depEid
        WHERE NOT EXISTS (SELECT 1 FROM work._lin_res x
                          WHERE x.eid = d.eid AND x.fromDs = s.fromDs AND x.fromVar = s.fromVar);
        SELECT COUNT(*) INTO :l_added TRIMMED FROM work._lin_new;
        INSERT INTO work._lin_res SELECT * FROM work._lin_new;
      QUIT;
    %end;
  %end;

  PROC SQL NOPRINT;
    /* ---- edges found from the source ---- */
    CREATE TABLE work._lin_eng AS
    SELECT e.step, t.toDs, t.toVar, e.kind AS method LENGTH=10, 'DS' AS fromKind LENGTH=6
         , s.fromDs LENGTH=1000, s.fromVar LENGTH=64, SUBSTR(e.expr, 1, 500) AS expr LENGTH=500
    FROM &p_prefix._eexpr e
    INNER JOIN work._lin_tgt t ON t.eid = e.eid
    INNER JOIN work._lin_res s ON s.eid = e.eid
    WHERE e.kind IN ('EXPR', 'RENAME')
    UNION
    SELECT e.step, t.toDs, t.toVar, 'CONST', 'NONE', '', '', SUBSTR(e.expr, 1, 500)
    FROM &p_prefix._eexpr e
    INNER JOIN work._lin_tgt t ON t.eid = e.eid
    WHERE e.kind = 'EXPR' AND NOT EXISTS (SELECT 1 FROM work._lin_res s WHERE s.eid = e.eid)
      AND NOT EXISTS (SELECT 1 FROM &p_prefix._ref r WHERE r.eid = e.eid)
    UNION
    SELECT e.step, t.toDs, t.toVar, 'INPUT'
         , CASE WHEN f.path IS NULL THEN 'INLINE' ELSE 'FILE' END
         , COALESCE(f.path, '(in-stream data)'), '', ''
    FROM &p_prefix._eexpr e
    INNER JOIN work._lin_tgt t ON t.eid = e.eid
    LEFT JOIN (SELECT DISTINCT step, path FROM &p_prefix._fileio WHERE role = 'INPUT') f ON f.step = e.step
    WHERE e.kind = 'INPUT';

    /* ---- everything else: same column name in an input of the step ---- */
    CREATE TABLE work._lin_name AS
    SELECT o.step, o.ds AS toDs LENGTH=80, o.var AS toVar LENGTH=64, 'NAME' AS method LENGTH=10, 'DS' AS fromKind LENGTH=6
         , i.ds AS fromDs LENGTH=1000, i.var AS fromVar LENGTH=64, '' AS expr LENGTH=500
    FROM work._lin_a o
    INNER JOIN work._lin_a i ON i.step = o.step AND i.role = 'INPUT' AND i.ukey = o.ukey
    WHERE o.role = 'OUTPUT'
      AND NOT EXISTS (SELECT 1 FROM work._lin_eng g WHERE g.step = o.step AND g.toDs = o.ds AND g.toVar = o.var);

    CREATE TABLE work._lin_c0 AS
    SELECT * FROM work._lin_eng
    UNION ALL
    SELECT * FROM work._lin_name;

    /* ---- output columns still without a source: read from a file, or unresolved ---- */
    CREATE TABLE work._lin_miss AS
    SELECT o.step, o.ds AS toDs LENGTH=80, o.var AS toVar LENGTH=64
    FROM work._lin_a o
    WHERE o.role = 'OUTPUT'
      AND NOT EXISTS (SELECT 1 FROM work._lin_c0 g WHERE g.step = o.step AND g.toDs = o.ds AND g.toVar = o.var);

    CREATE TABLE work._lin_file AS
    SELECT m.step, m.toDs, m.toVar, 'FILE' AS method LENGTH=10, 'FILE' AS fromKind LENGTH=6
         , f.path AS fromDs LENGTH=1000, '' AS fromVar LENGTH=64, '' AS expr LENGTH=500
    FROM work._lin_miss m
    INNER JOIN (SELECT DISTINCT step, path FROM &p_prefix._fileio WHERE role = 'INPUT') f ON f.step = m.step;

    CREATE TABLE work._lin_unres AS
    SELECT m.step, m.toDs, m.toVar, 'UNRESOLVED' AS method LENGTH=10, 'NONE' AS fromKind LENGTH=6
         , '' AS fromDs LENGTH=1000, '' AS fromVar LENGTH=64, '' AS expr LENGTH=500
    FROM work._lin_miss m
    WHERE NOT EXISTS (SELECT 1 FROM work._lin_file x WHERE x.step = m.step AND x.toDs = m.toDs AND x.toVar = m.toVar);

    CREATE TABLE work._lin_c1 AS
    SELECT * FROM work._lin_c0
    UNION ALL SELECT * FROM work._lin_file
    UNION ALL SELECT * FROM work._lin_unres;

    /* ---- data set versions: every step that writes a data set creates its next version ---- */
    CREATE TABLE work._lin_writes AS
    SELECT DISTINCT step, ds FROM &p_prefix._dsio WHERE role IN ('OUTPUT', 'UPDATE');

    CREATE TABLE &p_prefix._dsver AS
    SELECT DISTINCT d.step, 'IN' AS io LENGTH=3, d.ds LENGTH=80
         , (SELECT COUNT(*) FROM work._lin_writes w WHERE w.ds = d.ds AND w.step < d.step) AS ver
    FROM &p_prefix._dsio d WHERE d.role IN ('INPUT', 'UPDATE')
    UNION
    SELECT DISTINCT d.step, 'OUT', d.ds
         , (SELECT COUNT(*) FROM work._lin_writes w WHERE w.ds = d.ds AND w.step <= d.step)
    FROM &p_prefix._dsio d WHERE d.role IN ('OUTPUT', 'UPDATE');

    CREATE TABLE &p_prefix._collin AS
    SELECT c.step, s.procname LENGTH=32, c.method, c.fromKind, c.fromDs
         , CASE WHEN c.fromKind = 'DS'
                THEN (SELECT COUNT(*) FROM work._lin_writes w WHERE w.ds = c.fromDs AND w.step < c.step) ELSE 0 END AS fromVer
         , c.fromVar, c.toDs
         , (SELECT COUNT(*) FROM work._lin_writes w WHERE w.ds = c.toDs AND w.step <= c.step) AS toVer
         , c.toVar, c.expr
    FROM work._lin_c1 c
    LEFT JOIN &p_prefix._steps s ON s.step = c.step
    ORDER BY c.step, c.toDs, c.toVar, c.method, c.fromDs, c.fromVar;
  QUIT;

  PROC DATASETS LIB=WORK NOLIST NOWARN;
    DELETE _lin_ghost _lin_a _lin_dsmem _lin_raw _lin_nm _lin_al _lin_tgt _lin_src0 _lin_dr _lin_res _lin_eng
           _lin_new _lin_name _lin_c0 _lin_miss _lin_file _lin_unres _lin_c1 _lin_writes;
  RUN; QUIT;

%mend lin_buildLineage;
